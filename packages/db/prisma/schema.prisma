  triggerPayload Json               @map("trigger_payload")
  actionLog      Json               @default("[]") @map("action_log")
  startedAt      DateTime           @default(now()) @map("started_at")
  completedAt    DateTime?          @map("completed_at")

  @@index([tenantId])
  @@index([workflowId])
  @@map("workflow_runs")
  @@schema("chat")
}


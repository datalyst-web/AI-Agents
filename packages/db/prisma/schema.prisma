  @@index([tenantId])
  @@index([tenantId, timestamp])
  @@map("audit_log_entries")
  @@schema("chat")
}

// Singleton (always id "global") — the platform operator's OWN brand
// (e.g. "Datalyst Africa"), shown in the dashboard sidebar for staff's
// own unscoped view (Managed Setup, no active impersonation) and as the
// fallback for any tenant that hasn't been given its own white-label
// logo/name yet. Distinct from Tenant.logoObjectKey/brandName, which is
// per-client. Not a white-label violation (CLAUDE.md principle 6 is
// about hiding the AI provider/infra, not the reseller's own identity).
model PlatformSettings {
  id            String   @id @default("global")
  logoObjectKey String?  @map("logo_object_key")
  brandName     String?  @map("brand_name")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
  @@schema("chat")
}

// Backs packages/secrets' SecretsProvider interface when SECRETS_PROVIDER
// is "env" (the lean-launch default without AWS — see
// ALLOW_ENV_SECRETS_IN_PRODUCTION) via apps/api/src/lib/dbSecretsProvider.ts.
// `key` is the opaque credentialRef string tools.routes.ts already builds
// (e.g. "tenant/{tenantId}/tool/{toolId}") — not tenant-scoped RLS itself
// since that scoping already lives inside the key string by convention,
// same reasoning as ChannelConnection.encryptedCredential below.
// `encryptedValue` uses the same AES-256-GCM scheme as channelCrypto.ts
// (CHANNEL_CREDENTIALS_ENCRYPTION_KEY), reused rather than duplicated —
// the crypto itself was already generic, not actually channel-specific.
model PlatformSecret {
  key            String   @id
  encryptedValue String   @map("encrypted_value")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("platform_secrets")
  @@schema("chat")
}

// ---------------------------------------------------------------------------
// Channel integrations — deployment methods beyond the website widget /
// standalone URL (CLAUDE.md Deployment Surfaces). A client connects their
// own channel account (Telegram bot, WhatsApp number) to a specific agent;
// staff never do this on the client's behalf since it requires credentials
// only the client has (their bot token, their phone number).
// ---------------------------------------------------------------------------

enum ChannelType {
  TELEGRAM
  WHATSAPP
  FACEBOOK_MESSENGER
  INSTAGRAM

  @@schema("chat")
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR

  @@schema("chat")
}

model ChannelConnection {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId  String      @map("agent_id") @db.Uuid
  agent    Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channel  ChannelType
  status   ChannelConnectionStatus @default(PENDING)
  // Public-safe label for display (bot username, phone number) — never
  // the secret credential itself.
  externalLabel String? @map("external_label")
  // The provider-side id this connection routes on: Telegram uses the
  // per-connection webhook URL itself for routing (unset here), but
  // Meta's Messenger/Instagram/WhatsApp webhook is ONE shared platform
  // URL across every tenant's connections — an inbound event only
  // carries a Page/phone-number/IG-account id, so that id has to be
  // looked up here to find which tenant+agent it belongs to.
  externalId String? @map("external_id")
  // AES-256-GCM encrypted blob (bot token, access token) — see
  // apps/api/src/lib/channelCrypto.ts. Never returned to any client.
  encryptedCredential String? @map("encrypted_credential")
  // Per-connection shared secret Telegram echoes back on every webhook
  // call, checked against the request header — without this, anyone who
  // guesses/enumerates a connection id could POST fake "customer"
  // messages straight into the agent loop. Meta channels instead verify
  // the platform-wide X-Hub-Signature-256 header (see channels.routes.ts).
  webhookSecret String? @map("webhook_secret")
  errorMessage  String? @map("error_message")
  connectedAt   DateTime? @map("connected_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, agentId, channel])
  @@unique([channel, externalId])
  @@index([tenantId])
  @@map("channel_connections")
  @@schema("chat")
}

// ---------------------------------------------------------------------------
// Support tickets, security flagging, incidents, feature flags, templates,
// branding presets
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("chat")
}
enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("chat")
}

/// Every subscriptionState transition, timestamped — lets platform
/// analytics compute a real cohort-based churn rate (was cancelled ÷ total
/// as of NOW over a real time WINDOW) instead of the current-snapshot
/// approximation (cancelled ÷ total right now, no time dimension at all).
/// Written alongside every Tenant.subscriptionState update, never derived
/// after the fact.
model SubscriptionStateChange {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromState SubscriptionState? @map("from_state")
  toState   SubscriptionState  @map("to_state")
  changedAt DateTime           @default(now()) @map("changed_at")

  @@index([tenantId])
  @@index([changedAt])
  @@map("subscription_state_changes")
  @@schema("chat")
}

/// A client's own request to the platform team (not to be confused with
/// the "Ticketing" tool category an AGENT uses to create tickets in a
/// CLIENT's own external helpdesk — this is the client contacting US).
model SupportTicket {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject          String
  description      String
  status           SupportTicketStatus    @default(OPEN)
  priority         SupportTicketPriority  @default(NORMAL)
  createdByUserId  String                 @map("created_by_user_id") @db.Uuid
  // Staff user id — not a DB relation, same reasoning as
  // Conversation.takenOverByUserId above (staff rows aren't tenant-scoped).
  assignedToStaffUserId String?           @map("assigned_to_staff_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  resolvedAt       DateTime?              @map("resolved_at")

  @@index([tenantId])
  @@map("support_tickets")
  @@schema("chat")
}

/// Heuristic flags on customer messages matching known prompt-injection/
/// jailbreak phrasing (see wordpressConnect-style heuristic already used
/// for the gap report) — a detection aid for staff review, never an
/// automatic block, since false positives on a legitimate customer
/// message are far worse than a staff member spending a minute reviewing
/// one that turned out to be nothing.
model PromptInjectionFlag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId        String   @map("agent_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  matchedPhrase  String   @map("matched_phrase")
  content        String
  flaggedAt      DateTime @default(now()) @map("flagged_at")
  reviewed       Boolean  @default(false)
  reviewedByUserId String? @map("reviewed_by_user_id") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at")

  @@index([tenantId])
  @@map("prompt_injection_flags")
  @@schema("chat")
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL

  @@schema("chat")
}
enum IncidentStatus {
  OPEN
  MONITORING
  RESOLVED

  @@schema("chat")
}

/// Platform-level (not tenant-scoped — an AI provider outage or infra
/// incident affects the whole platform, not one client) — deliberately
/// NOT RLS-covered like the tenant tables above, since it never carries
/// tenant_id in the first place. Staff-only, gated the same way
/// System Health is (platform:manage_tenants).
model IncidentLogEntry {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String
  severity        IncidentSeverity @default(MINOR)
  status          IncidentStatus   @default(OPEN)
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  startedAt       DateTime         @default(now()) @map("started_at")
  resolvedAt      DateTime?        @map("resolved_at")

  @@map("incident_log_entries")
  @@schema("chat")
}

/// Platform-level, not tenant-scoped — a feature flag is a platform
/// operator decision about what a given plan tier can access, not
/// something any individual tenant configures.
model FeatureFlag {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String             @unique
  name          String
  description   String
  enabledTiers  SubscriptionTier[] @map("enabled_tiers")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@map("feature_flags")
  @@schema("chat")
}

/// Starting-point templates staff apply when configuring a new client's
/// agent under Managed Setup — never auto-applied without a staff member
/// choosing one (CLAUDE.md: staff configure through the same tools a
/// client would, deliberately, not a silent default).
model PromptTemplate {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  description            String
  systemInstructions     String   @map("system_instructions")
  guardrailPolicy        String   @default("PREFER_UNKNOWN_OVER_INVENTED_FACT_CONFIRM_BEFORE_ACTING") @map("guardrail_policy")
  isDefault              Boolean  @default(false) @map("is_default")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("prompt_templates")
  @@schema("chat")
}

/// A reusable white-label identity (name + logo) staff can apply to a
/// tenant in one click instead of re-uploading the same client's assets
/// by hand every time — e.g. an agency reseller's own consistent brand
/// across many of their own sub-clients.
model BrandingPreset {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  brandName     String   @map("brand_name")
  logoObjectKey String?  @map("logo_object_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("branding_presets")
  @@schema("chat")
}

/// A browser/device registered for Web Push (see packages/push) so
/// escalationNotificationSweep can deliver a real push notification when a
/// user has notifyEscalationPush on — not tenant-scoped like most models
/// here (a platform staff user has no tenantId at all), same reasoning as
/// FeatureFlag/PromptTemplate/BrandingPreset above; access is instead
/// self-service, scoped to the caller's own userId in the route (see
/// auth.routes.ts), not RLS.
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Staff/tenant user id — not a DB relation, same reasoning as
  // Conversation.takenOverByUserId elsewhere (not every user is tenant-scoped).
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
  @@schema("chat")
}

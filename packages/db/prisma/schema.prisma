enum PaynowPaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED

  @@schema("chat")
}

// One row per checkout attempt (Paynow's `reference` field, which we
// generate and Paynow echoes back on every callback/poll, is how an
// inbound webhook or poll response gets correlated back to what it was
// for). A BillingLineItem is only ever created once a payment actually
// reaches PAID — this row exists so a customer bouncing off Paynow's
// hosted page without paying, or a webhook that never arrives, doesn't
// silently vanish: it's a real row an admin can see and reconcile.
model PaynowPayment {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference        String              @unique
  paynowReference  String?             @map("paynow_reference")
  pollUrl          String?             @map("poll_url")
  skuType          BillingSkuType      @map("sku_type")
  description      String
  amountUsd        Decimal             @map("amount_usd") @db.Decimal(12, 2)
  status           PaynowPaymentStatus @default(PENDING)
  subscriptionTier SubscriptionTier?   @map("subscription_tier")
  periodStart      DateTime?           @map("period_start")
  periodEnd        DateTime?           @map("period_end")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("paynow_payments")
  @@schema("chat")
}

model UsageLimits {
  tenantId                       String   @id @map("tenant_id") @db.Uuid
  tenant                         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  includedConversationsPerMonth  Int      @map("included_conversations_per_month")
  includedTokensPerMonth         Int      @map("included_tokens_per_month")
  overageRatePerThousandTokensUsd Decimal @map("overage_rate_per_thousand_tokens_usd") @db.Decimal(10, 4)
  hardCapTokensPerMonth          Int?     @map("hard_cap_tokens_per_month")

  @@map("usage_limits")
  @@schema("chat")
}


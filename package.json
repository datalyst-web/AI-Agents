{
  "name": "ai-chat-agent-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Universal AI Chat Agent Platform — multi-tenant SaaS, shared AWS platform with the Voice Agent product",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r run build && vitest run",
    "db:generate": "pnpm --filter @chat-agent/db run generate",
    "db:migrate": "pnpm --filter @chat-agent/db run migrate",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}

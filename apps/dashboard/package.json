{
  "name": "@chat-agent/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @chat-agent/widget build && node -e \"require('fs').copyFileSync('../widget/dist/widget.js','public/widget.js')\" && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "clean": "rimraf .next .turbo"
  },
  "dependencies": {
    "@chat-agent/shared-types": "workspace:*",
    "@chat-agent/ui": "workspace:*",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "rimraf": "^6.0.1"
  }
}

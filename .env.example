# ============================================================================
# AI Chat Agent Platform — environment variables
# Copy to .env and fill in. Nothing here has a real value checked in.
# In production these are NOT read from .env — they come from AWS Secrets
# Manager / KMS via packages/secrets. .env is for local/dev only, and dev
# defaults to Gemini + local Postgres per CLAUDE.md principle 7.
# ============================================================================

NODE_ENV=development

# ---- Model Router (packages/ai-provider) -----------------------------------
# Dev/CI default: Gemini only. Production: all three, with failover
# Anthropic -> OpenAI -> Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

ANTHROPIC_MODEL_ID=claude-sonnet-5
# Per-tier Claude models a tenant can pick between in the dashboard.
ANTHROPIC_MODEL_HAIKU_ID=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET_ID=claude-sonnet-5
ANTHROPIC_MODEL_OPUS_ID=claude-opus-5
OPENAI_MODEL_ID=gpt-5
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Embeddings are a separate model family per vendor — never a chat model id.
OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-001

# Which provider to use when none is forced (dev should be "gemini")
DEFAULT_AI_PROVIDER=gemini
AI_FAILOVER_CHAIN=anthropic,openai,gemini

# ---- Database (packages/db) -------------------------------------------------
# Shared Aurora Postgres cluster in production, `chat` schema.
# Local dev: any Postgres 16+ with the pgvector extension.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_agent?schema=chat
DATABASE_SHADOW_URL=postgresql://postgres:postgres@localhost:5432/chat_agent_shadow?schema=chat

# ---- Cache / rate limiting (ElastiCache Redis, shared, `chat:` prefix) -----
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=chat:

# ---- Object storage (shared S3 bucket, `chat/{tenantId}/...` prefix) ------
S3_BUCKET=agents-platform-storage
S3_KEY_PREFIX=chat
AWS_REGION=us-east-1

# ---- Async queues (shared SQS, chat-* queues) ------------------------------
SQS_KNOWLEDGE_INGEST_QUEUE_URL=
SQS_WORKFLOW_RUN_QUEUE_URL=
SQS_FOLLOWUP_QUEUE_URL=
# Local dev fallback: an in-memory queue is used automatically when these
# are unset (see packages/config).

# ---- Secrets (packages/secrets) --------------------------------------------
# Local/dev: falls back to reading the vars in this file directly.
# Production: set to "aws" to require Secrets Manager/KMS.
SECRETS_PROVIDER=env
SECRETS_PATH_PREFIX=chat/
# Required to boot with NODE_ENV=production and SECRETS_PROVIDER!=aws — an
# explicit, temporary opt-out for a lean launch without AWS infra yet.
ALLOW_ENV_SECRETS_IN_PRODUCTION=false

# ---- Auth --------------------------------------------------------------------
JWT_SECRET=dev-only-change-me
JWT_ISSUER=ai-chat-agent-platform
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ---- apps/api ----------------------------------------------------------------
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MIN=120

# ---- apps/dashboard ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WIDGET_SCRIPT_URL=http://localhost:5000/widget.js

# ---- apps/widget ---------------------------------------------------------------
WIDGET_PORT=5000
WIDGET_API_BASE_URL=http://localhost:4000

# ---- apps/workers --------------------------------------------------------------
WORKERS_CONCURRENCY=4

# ---- Observability -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# ---- Billing (Stripe or equivalent, proxied — never exposed to clients) ----
BILLING_PROVIDER_API_KEY=
BILLING_WEBHOOK_SECRET=

# ---- Third-party integrations available to the Tool Engine (per-tenant) ---
# Real per-tenant integration credentials are stored encrypted in the DB /
# Secrets Manager, never in this file. These are only platform-level
# fallbacks/defaults for staff-run Managed Setup testing.
DEFAULT_SMTP_URL=
